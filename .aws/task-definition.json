{
  "family": "tkt-mrittika-tf-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::243112136699:role/tkt-mrittika-tf-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::243112136699:role/tkt-mrittika-tf-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "ticketdesk-api",
      "image": "PLACEHOLDER",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "ATTACHMENTS_BUCKET",
          "value": "tkt-mrittika-attachments-671b5cff07f786f3ea03e017fb"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "secrets": [
        {
          "name": "DB_HOST",
          "valueFrom": "arn:aws:ssm:ap-southeast-2:243112136699:parameter/ticketdesk/db/host"
        },
        {
          "name": "DB_PORT",
          "valueFrom": "arn:aws:ssm:ap-southeast-2:243112136699:parameter/ticketdesk/db/port"
        },
        {
          "name": "DB_NAME",
          "valueFrom": "arn:aws:ssm:ap-southeast-2:243112136699:parameter/ticketdesk/db/name"
        },
        {
          "name": "DB_USER",
          "valueFrom": "arn:aws:ssm:ap-southeast-2:243112136699:parameter/ticketdesk/db/user"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:243112136699:secret:rds!db-93162426-deeb-4348-b3ee-6637214da277-oi3GW7:password::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/tkt-mrittika-tf-task",
          "awslogs-region": "ap-southeast-2",
          "awslogs-stream-prefix": "api"
        }
      }
    }
  ]
}